# Unity-generated caches, local state and builds
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Bb]uild/
/[Bb]uilds/
/[Aa]rtifacts/
/[Ee]xported[Oo]bj/
/[Cc]aptures/
/[Ss]creenshots/

# IDE files regenerated by Unity (keep .vsconfig)
/.vs/
/.idea/
/.vscode/
/*.csproj
/*.sln
/*.slnx
/*.suo
/*.user
/*.userprefs
/*.pidb
/*.booproj
/*.opendb
/*.VC.db
/*.unityproj
/sysinfo.txt
/crash.dmp
/mono_crash.*
/RuntimeActionBindings.json
/Assets/StreamingAssets/RuntimeActionBindings.json
/Assets/StreamingAssets/RuntimeActionBindings.json.meta

# Local integrations: downloaded apps, cloned servers, virtual environments,
# captures, request payloads and machine-specific diagnostic reports.
# Keep the reusable helper scripts and their documentation.
/Tools/Integrations/*
!/Tools/Integrations/*.py
!/Tools/Integrations/*.ps1
!/Tools/Integrations/LISEZ-MOI.md
/Ouvrir Blender.lnk

# Automatic scene snapshots (keep the actual source scenes and their metadata)
/Assets/SnakeArcade/Backups/
/Assets/SnakeArcade/Backups.meta
/Assets/HandTrackingMiniJeu/Backups/
/Assets/HandTrackingMiniJeu/Backups.meta

# Meta SDK developer-agent settings contain a generated local access token/IP.
/Assets/Resources/DevAgentSettings.asset
/Assets/Resources/DevAgentSettings.asset.meta

# Python caches and local configuration/credentials
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example
!.env.sample
/.codex/
/.agents/
/.aws/
*.keystore
*.jks
*.keystore.meta
*.jks.meta

# Unity-generated asset sidecars
*.pidb.meta
*.pdb.meta
*.mdb.meta
/Assets/AddressableAssetsData/*/*.bin*
/Assets/StreamingAssets/aa/
/Assets/StreamingAssets/aa.meta

# OS and editor temporary files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
